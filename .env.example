# Copy this file to `.env` and fill in OPENAI_API_KEY. Every variable below is REQUIRED

# --- LLM provider: OpenAI only, required for discovery/routing/validation ---
# Set your key here. Replay is deterministic and never uses an LLM or any key.
# (Unit tests inject their own LLM double and do not need a key.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Target app login (supplied at invocation; redacted from logs, never persisted) ---
APP_USERNAME=operator1
APP_PASSWORD=changeit

# --- Target app ---
# The local mock legacy back-office app used as the proxy target.
TARGET_BASE_URL=http://127.0.0.1:5001

# --- Operator handoff surface ---
OPERATOR_BASE_URL=http://127.0.0.1:5002

# --- Runtime ---
HEADLESS=true
MAX_STEPS=25
STEP_TIMEOUT_MS=8000

# Remote-debugging (CDP) port exposed during human handoff so an operator can attach
# to the same live browser session (chrome://inspect -> localhost:<port>).
HANDOFF_CDP_PORT=9222
